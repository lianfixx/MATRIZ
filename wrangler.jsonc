// Matriz en Cloudflare Workers: el panel (archivos de dist/) y el conector MCP de solo lectura en /mcp.
// Lo publica .github/workflows/publicar-panel.yml; también: `python3 tools/panel.py && npx wrangler deploy`.
{
  "name": "matriz",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Límite de intentos de contraseña del panel: 5 por minuto por dirección IP, en todos los servidores.
  "ratelimits": [{ "name": "LIMITE_ENTRAR", "namespace_id": "4501", "simple": { "limit": 5, "period": 60 } }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/", "/api/*"]
  }
}
