// Matriz en Cloudflare Workers: el panel (archivos de dist/) y el conector MCP de solo lectura en /mcp.
// Lo publica .github/workflows/publicar-panel.yml; también: `python3 tools/panel.py && npx wrangler deploy`.
{
  "name": "matriz",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Límite exacto de intentos fallidos de contraseña del panel (Durable Object «Intentos», plan gratis).
  "durable_objects": { "bindings": [{ "name": "INTENTOS", "class_name": "Intentos" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Intentos"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/", "/api/*"]
  }
}
